    classDef cloudinary fill:#3448c5,stroke:#1e3a8a,color:#fff
    classDef funcvn fill:#f59e0b,stroke:#d97706,color:#000
    classDef cron fill:#ef4444,stroke:#b91c1c,color:#fff
    classDef zalo fill:#0068ff,stroke:#0050cc,color:#fff
    classDef schema fill:#fef3c7,stroke:#d97706,color:#92400e

    class Browser client
    class LoginPage,Dashboard,MW,APIUpload,APIGroupInfo,APISend,APICron,APICronManual vercel
    class Auth,DB,Tables supabase
    class Cloudinary cloudinary
    class FuncVN funcvn
    class CronJob cron
    class Zalo zalo
    class SchemaA,SchemaB,SchemaC,SchemaD,SchemaE,SchemaF schema
