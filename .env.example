# Sao chép file này thành .env.local rồi điền giá trị của bạn.
# KHÔNG commit .env.local lên GitHub (đã có trong .gitignore).

# --- Supabase (bắt buộc) ---
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Khoá service role: chỉ dùng phía server, tuyệt đối không đưa lên trình duyệt
SUPABASE_SERVICE_ROLE_KEY=

# Địa chỉ web của bạn, dùng để chuyển hướng sau khi đăng nhập Google
APP_SITE_URL=http://localhost:3000

# --- Bộ lập lịch gửi tin ---
# Chuỗi ngẫu nhiên dài, tạo bằng: openssl rand -base64 32
CRON_SECRET=
# (tuỳ chọn) campaign trễ quá số phút này sẽ bị tạm dừng thay vì gửi bù. Mặc định 60
# CRON_MAX_LATE_MINUTES=60
# (tuỳ chọn) =1 để /api/cron chỉ nhận lời gọi từ chính máy chủ (loopback)
# CRON_REQUIRE_LOOPBACK=

# --- Lưu ảnh: Cloudflare R2 (cần khi đính kèm ảnh) ---
# Cloudflare → R2 → Manage API Tokens: quyền Object Read & Write cho đúng bucket
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL công khai của bucket (custom domain hoặc r2.dev)
R2_PUBLIC_URL=https://<your-public-domain>
